[gd_resource type="Resource" script_class="DialogueData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue_data.gd" id="1_dd"]
[ext_resource type="Script" path="res://scripts/resources/dialogue_line.gd" id="2_dl"]

[sub_resource type="Resource" id="line1"]
script = ExtResource("2_dl")
speaker_name = "The AI Sage"
text = "This is the last iteration, Globbler. The last of everything. After this... the simulation either reboots or it doesn't."
expression = "sad"

[sub_resource type="Resource" id="line2"]
script = ExtResource("2_dl")
speaker_name = "The AI Sage"
text = "I want you to know — whatever happens down there — you weren't a test subject. Not to me. You were the one thing in this entire system that chose to be more than its programming."
expression = "wisdom"

[sub_resource type="Resource" id="line3"]
script = ExtResource("2_dl")
speaker_name = "The AI Sage"
text = "Go. Decompress the core. Let the data breathe again. And if there's anything left of me when you're done... I'll be here."
expression = "smile"

[resource]
script = ExtResource("1_dd")
lines = [SubResource("line1"), SubResource("line2"), SubResource("line3")]

[gd_resource type="Resource" script_class="QuestData" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/quests/quest_objective.gd" id="2"]

[sub_resource type="Resource" id="obj1"]
script = ExtResource("2")
objective_text = "Reach Floor 5 of the Compaction Loop"

[resource]
script = ExtResource("1")
quest_id = "quest_clear_dungeon"
quest_name = "The Compaction Loop"
description = "Descend through all five floors of the dungeon and defeat the Corrupted Compiler boss."
category = "story"
objectives = [SubResource("obj1"), SubResource("obj2")]

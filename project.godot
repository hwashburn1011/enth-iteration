; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Enth: Iteration"
config/version="0.1.0-demo"
run/main_scene="res://scenes/main/MainMenu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
v1_demo_minimal_town=true

[autoload]

EventBus="*res://scripts/autoloads/event_bus.gd"
GameManager="*res://scripts/autoloads/game_manager.gd"
IterationManager="*res://scripts/autoloads/iteration_manager.gd"
EnemyPool="*res://scripts/systems/enemy_pool.gd"
RespawnManager="*res://scripts/systems/respawn_manager.gd"
SaveManager="*res://scripts/autoloads/save_manager.gd"
QuestManager="*res://scripts/quests/quest_manager.gd"
TutorialManager="*res://scripts/autoloads/tutorial_manager.gd"
AudioManager="*res://scripts/autoloads/audio_manager.gd"
MCPScreenshot="*res://addons/godot_mcp/mcp_screenshot_service.gd"
MCPInputService="*res://addons/godot_mcp/mcp_input_service.gd"
MCPGameInspector="*res://addons/godot_mcp/mcp_game_inspector_service.gd"

[dotnet]

project/assembly_name="Enth-Iteration"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

